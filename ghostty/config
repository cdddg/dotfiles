# Theme
theme = Catppuccin Mocha

# Font (repeat font-family for fallback chain)
font-family = "Monaspace Neon Var"
# CJK fallback
font-family = "PingFang TC"
font-size = 12
adjust-cell-height = 6%

# Monaspace font features: https://github.com/githubnext/monaspace#coding-ligatures
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss07
font-feature = ss08
font-feature = ss09
font-feature = cv01=2
font-feature = cv02

# Keybindings — Tmux (prefix C-b = \x02)
# keybind = cmd+t=text:\x02c
# keybind = cmd+w=text:\x02x
# keybind = cmd+d=text:\x02%
# keybind = cmd+shift+d=text:\x02"
# keybind = cmd+digit_1=unbind
# keybind = cmd+digit_2=unbind
