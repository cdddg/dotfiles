# keybind = cmd+k=text:clear
# keybind = cmd+n=text:\x02N
# keybind = cmd+grave_accent=text:\x02)

# Keybindings — Neovim
keybind = cmd+s=text:\x13
keybind = cmd+shift+s=text:\x1b[83;6u

# Keybindings — Split
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right
keybind = alt+shift+h=resize_split:left,10
keybind = alt+shift+j=resize_split:down,10
keybind = alt+shift+k=resize_split:up,10
keybind = alt+shift+l=resize_split:right,10

# Keybindings — Font size (apply to all panes)
keybind = all:super+equal=increase_font_size:1
keybind = all:super+plus=increase_font_size:1
keybind = all:super+minus=decrease_font_size:1
keybind = all:super+zero=reset_font_size

# Terminal
# command = /bin/zsh -c "tmux new-session -A -s 0"
shell-integration-features = no-cursor,sudo,title
selection-clear-on-copy = true
window-inherit-working-directory = false
tab-inherit-working-directory = false
split-inherit-working-directory = true
confirm-close-surface = false
maximize = true
# window-padding-y = 6,2
window-padding-x = 4

# macOS
macos-option-as-alt = left
macos-titlebar-style = tabs
macos-window-buttons = hidden
mouse-hide-while-typing = true
