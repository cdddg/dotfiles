zsh-defer-list() {
  if [[ -z $_zsh_defer_tasks ]]; then
    echo "💤  no deferred tasks"
    return
  fi

  local -a lines
  lines=("${(@f)_zsh_defer_tasks}")
  local i=1
  for line in $lines; do
    local parts=(${(z)line})
    local delay=${parts[1]}
    local cmd=${(j: :)parts[3,-1]}
    echo "[$i] ${delay}ms - ${cmd}"
    ((i++))
  done
}

# git: Show git aliases and functions (auto-loaded from current environment)
#
# Usage:
#   zsh-git-help           # Show all aliases grouped by category
#   zsh-git-help --list    # Show simple alphabetical list
#   zsh-git-help commit    # Filter by keyword
#   zsh-git-help --help    # Show help
#
zsh-git-help() {
  local show_category="${1:-all}"

  # Color codes
  local BOLD='\033[1m' RESET='\033[0m' CYAN='\033[36m'
  local GREEN='\033[32m' YELLOW='\033[33m' GRAY='\033[90m'

  # Show help
  if [[ "$show_category" == "--help" ]]; then
    echo "Usage: zsh-git-help [mode]"
    echo ""
    echo "Modes:"
    echo "  (none)    - Show all aliases grouped by category"
    echo "  --list    - Show all aliases in a simple list"
    echo "  <keyword> - Filter by keyword (e.g., commit, branch, stash)"
    echo ""
    echo "Examples:"
    echo "  zsh-git-help              # Grouped by category"
    echo "  zsh-git-help --list       # Simple alphabetical list"
    echo "  zsh-git-help commit       # Filter by 'commit'"
    return 0
  fi

  # Get plugin date
  local plugin_file="$HOME/.local/share/zinit/snippets/OMZ::plugins--git/git.plugin.zsh"
  local plugin_date="unknown"
  if [[ -d "$plugin_file" ]]; then
    local files=("$plugin_file"/**/*.zsh(N))
    [[ ${#files[@]} -gt 0 ]] && plugin_date=$(date -r "${files[1]}" "+%Y-%m-%d" 2>/dev/null || echo "unknown")
  fi

  # Print header
  echo -e "${BOLD}${CYAN}Git Aliases & Functions${RESET}"
  echo -e "${GRAY}Source: Oh My Zsh git plugin (via zinit)${RESET}"
  [[ "$show_category" != "all" ]] && echo -e "${YELLOW}Filter: $show_category${RESET}"
  echo -e "${GRAY}Plugin updated: ${plugin_date}${RESET}\n"

  # Load all git aliases and functions
  local -A git_items

  # Load aliases
  while IFS= read -r line; do
    if [[ $line =~ ^alias\ (\'?)([^=\']+)(\'?)=(.*)$ ]]; then
      local name="${match[2]}" value="${match[4]}"
      value="${value#\'}"; value="${value%\'}"
      value="${value#\$\'}"; value="${value%\'}"
      [[ $name == g* ]] && git_items[$name]="$value"
    fi
  done < <(alias -L)

  # Load functions
  for func in $(functions | grep "^g" | cut -d' ' -f1); do
    [[ $func == _* || $func == git_* || $func == current_branch ]] && continue
    if functions $func | grep -q "git"; then
      git_items[$func]="<function>"
    fi
  done

  # Mode: Keyword filter
  if [[ "$show_category" != "all" ]] && [[ "$show_category" != "--list" ]]; then
    local count=0
    for key in ${(ko)git_items}; do
      local value="${git_items[$key]}"
      if echo "$key $value" | grep -iq "$show_category"; then
        ((count++))
        # Print item
        if [[ "$value" == *"deprecated"* ]]; then
          local replacement=$(echo "$value" | grep -o "%F{green}[^%]*" | sed 's/%F{green}//')
          printf "  ${GRAY}%-15s${RESET} ${GRAY}→ Use ${GREEN}%s${RESET} ${GRAY}instead${RESET} ${YELLOW}(DEPRECATED)${RESET}\n" "$key" "$replacement"
        elif [[ "$value" == "<function>" ]]; then
          local func_body=$(functions "$key" 2>/dev/null | grep -E "git |command " | head -1 | sed 's/^[[:space:]]*//')
          [[ ${#func_body} -gt 60 ]] && func_body="${func_body:0:57}..."
          if [[ -n "$func_body" ]]; then
            printf "  ${CYAN}%-15s${RESET} ${GRAY}→${RESET} ${GRAY}%s${RESET} ${CYAN}(FUNCTION)${RESET}\n" "$key" "$func_body"
          else
            printf "  ${CYAN}%-15s${RESET} ${GRAY}→${RESET} ${CYAN}<FUNCTION>${RESET}\n" "$key"
          fi
        else
          printf "  ${GREEN}%-15s${RESET} ${GRAY}→${RESET} %s\n" "$key" "$value"
        fi
      fi
    done
    echo ""
    echo -e "${GRAY}Showing: $count/${#git_items[@]} aliases/functions${RESET}"
    return 0
  fi

  # Mode: Simple list
  if [[ "$show_category" == "--list" ]]; then
    for key in ${(ko)git_items}; do
      local value="${git_items[$key]}"
      if [[ "$value" == *"deprecated"* ]]; then
        local replacement=$(echo "$value" | grep -o "%F{green}[^%]*" | sed 's/%F{green}//')
        printf "  ${GRAY}%-15s${RESET} ${GRAY}→ Use ${GREEN}%s${RESET} ${GRAY}instead${RESET} ${YELLOW}(DEPRECATED)${RESET}\n" "$key" "$replacement"
      elif [[ "$value" == "<function>" ]]; then
        local func_body=$(functions "$key" 2>/dev/null | grep -E "git |command " | head -1 | sed 's/^[[:space:]]*//')
        [[ ${#func_body} -gt 60 ]] && func_body="${func_body:0:57}..."
        if [[ -n "$func_body" ]]; then
          printf "  ${CYAN}%-15s${RESET} ${GRAY}→${RESET} ${GRAY}%s${RESET} ${CYAN}(FUNCTION)${RESET}\n" "$key" "$func_body"
        else
          printf "  ${CYAN}%-15s${RESET} ${GRAY}→${RESET} ${CYAN}<FUNCTION>${RESET}\n" "$key"
        fi
      else
        printf "  ${GREEN}%-15s${RESET} ${GRAY}→${RESET} %s\n" "$key" "$value"
      fi
    done
    echo ""
    echo -e "${GRAY}Total: ${#git_items[@]} aliases/functions${RESET}"
    return 0
  fi

  # Mode: Grouped by category (default)
  local -A item_categories
  local category_order=(
    "Basic (status, diff)" "Add" "Commit" "Branch" "Checkout/Switch"
    "Pull/Fetch" "Push" "Merge" "Rebase" "Stash" "Log"
    "Reset/Clean/Restore" "Remote" "Show/Describe" "Tags" "Worktree"
    "Cherry-pick" "Revert" "Bisect" "Submodule" "Other"
  )

  # Categorize items
  for key in ${(k)git_items}; do
    local value="${git_items[$key]}"
    case "$value" in
      *stash*) item_categories[$key]="Stash" ;;
      *worktree*) item_categories[$key]="Worktree" ;;
      *remote*) item_categories[$key]="Remote" ;;
      *mergetool*) item_categories[$key]="Merge" ;;
      *status*|*" diff"*|"git diff"*) item_categories[$key]="Basic (status, diff)" ;;
      *" add"*|*apply*) item_categories[$key]="Add" ;;
      *commit*) item_categories[$key]="Commit" ;;
      *branch*) item_categories[$key]="Branch" ;;
      *checkout*|*switch*) item_categories[$key]="Checkout/Switch" ;;
      *pull*|*fetch*) item_categories[$key]="Pull/Fetch" ;;
      *push*) item_categories[$key]="Push" ;;
      *merge*) item_categories[$key]="Merge" ;;
      *rebase*) item_categories[$key]="Rebase" ;;
      *log*|*whatchanged*) item_categories[$key]="Log" ;;
      *reset*|*clean*|*restore*) item_categories[$key]="Reset/Clean/Restore" ;;
      *show*|*describe*) item_categories[$key]="Show/Describe" ;;
      *tag*) item_categories[$key]="Tags" ;;
      *cherry-pick*) item_categories[$key]="Cherry-pick" ;;
      *revert*) item_categories[$key]="Revert" ;;
      *bisect*) item_categories[$key]="Bisect" ;;
      *submodule*) item_categories[$key]="Submodule" ;;
      *) item_categories[$key]="Other" ;;
    esac
  done

  # Display by category
  local -A displayed
  local first_category=1

  for cat in "${category_order[@]}"; do
    # Check if category has items
    local has_items=0
    for key in ${(k)item_categories}; do
      [[ "${item_categories[$key]}" == "$cat" ]] && has_items=1 && break
    done
    [[ $has_items -eq 0 ]] && continue

    # Print separator and header
    [[ $first_category -eq 0 ]] && echo ""
    first_category=0
    echo -e "${BOLD}${YELLOW}$cat${RESET}"

    # Group items by git subcommand
    local -A subcmd_groups=()
    local subcmd_order=()
    for key in ${(k)git_items}; do
      if [[ "${item_categories[$key]}" == "$cat" ]] && [[ -z "${displayed[$key]}" ]]; then
        local value="${git_items[$key]}"
        local subcmd="~other"

        # Extract git subcommand
        if [[ "$value" == *"deprecated"* ]]; then
          subcmd="~deprecated"
        elif [[ "$value" == "<function>" ]]; then
          subcmd="~function"
        elif [[ "$value" =~ git\ ([a-z-]+) ]]; then
          subcmd="${match[1]}"
        fi

        if [[ -z "${subcmd_groups[$subcmd]}" ]]; then
          subcmd_groups[$subcmd]="$key"
          subcmd_order+=("$subcmd")
        else
          subcmd_groups[$subcmd]+=" $key"
        fi
      fi
    done

    # Sort: normal subcommands first, then special (~) ones
    local sorted_subcmds=()
    for subcmd in ${(o)subcmd_order}; do
      [[ "$subcmd" != ~* ]] && sorted_subcmds+=("$subcmd")
    done
    for subcmd in ${(o)subcmd_order}; do
      [[ "$subcmd" == ~* ]] && sorted_subcmds+=("$subcmd")
    done

    # Print items grouped by subcommand
    for subcmd in "${sorted_subcmds[@]}"; do
      for key in ${(o)${(z)subcmd_groups[$subcmd]}}; do
        local value="${git_items[$key]}"
        if [[ "$value" == *"deprecated"* ]]; then
          local replacement=$(echo "$value" | grep -o "%F{green}[^%]*" | sed 's/%F{green}//')
          printf "  ${GRAY}%-15s${RESET} ${GRAY}→ Use ${GREEN}%s${RESET} ${GRAY}instead${RESET} ${YELLOW}(DEPRECATED)${RESET}\n" "$key" "$replacement"
        elif [[ "$value" == "<function>" ]]; then
          local func_body=$(functions "$key" 2>/dev/null | grep -E "git |command " | head -1 | sed 's/^[[:space:]]*//')
          [[ ${#func_body} -gt 60 ]] && func_body="${func_body:0:57}..."
          if [[ -n "$func_body" ]]; then
            printf "  ${CYAN}%-15s${RESET} ${GRAY}→${RESET} ${GRAY}%s${RESET} ${CYAN}(FUNCTION)${RESET}\n" "$key" "$func_body"
          else
            printf "  ${CYAN}%-15s${RESET} ${GRAY}→${RESET} ${CYAN}<FUNCTION>${RESET}\n" "$key"
          fi
        else
          printf "  ${GREEN}%-15s${RESET} ${GRAY}→${RESET} %s\n" "$key" "$value"
        fi
        displayed[$key]=1
      done
    done
  done

  # Summary
  echo ""
  echo -e "${GRAY}Total: ${#git_items[@]} aliases/functions${RESET}"
}

# gwtrm: Pick git worktree(s) via fzf and remove. Optionally delete the branch too.
# Flags:
#   -b, --with-branch  Also delete the branch (uses git branch -d; -D when -f given)
#   -f, --force        git worktree remove --force (override tracked modifications);
#                      with -b, also force branch delete (-D)
# Safety (NOT overridable by -f):
#   - Skip if worktree has untracked files
#   - Skip if worktree's .claude/ has anything other than settings.local.json
# Main worktree and the current worktree are excluded from the picker.
gwtrm() {
  local repo_root with_branch=0 force=0 arg
  for arg in "$@"; do
    case "$arg" in
      -b|--with-branch) with_branch=1 ;;
      -f|--force) force=1 ;;
      -bf|-fb) with_branch=1; force=1 ;;
      -h|--help)
        echo "Usage: gwtrm [-b|--with-branch] [-f|--force]"; return 0 ;;
      *) echo "gwtrm: unknown arg: $arg" >&2; return 1 ;;
    esac
  done

  repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || return

  local list
  list=$(git worktree list --porcelain 2>/dev/null \
    | awk -v root="$repo_root" -v pwd="$PWD" '
        BEGIN {
          R="\033[0m"; DIM="\033[2m"
          GREEN="\033[32m"; YELLOW="\033[33m"; GREY="\033[90m"
        }
        /^worktree /  { path=substr($0,10) }
        /^HEAD /      { commit=substr($2,1,8) }
        /^branch /    { branch=$2; sub("refs/heads/","",branch) }
        /^detached$/  { branch="(detached)" }
        /^$/ {
          if (path && path!=root && path!=pwd) {
            prefix=root"/"
            rel=(index(path,prefix)==1 ? substr(path,length(prefix)+1) : path)
            bcol=(branch=="(detached)" ? GREY : GREEN)
            pad=45-length(branch); if (pad<0) pad=0
            spaces=sprintf("%*s", pad, "")
            printf "  %s%s%s%s %s%s%s  %s%s%s\t%s\t%s\n",
              bcol, branch, R, spaces, YELLOW, commit, R, DIM, rel, R, path, branch
          }
          path=""; commit=""; branch=""
        }')

  if [[ -z $list ]]; then
    echo "gwtrm: no removable worktrees (main and current are excluded)" >&2
    return 0
  fi

  local selected
  selected=$(print -r -- "$list" \
    | fzf --ansi --multi \
          --header='Remove worktree(s)  TAB=multi-select, ENTER=confirm' \
          --delimiter='\t' --with-nth=1 \
          --preview='git -C {2} log --oneline --decorate --color=always -20 2>/dev/null' \
          --preview-window='right:60%:wrap')

  [[ -z $selected ]] && return 0

  local wt branch extra untracked
  local warn=$'\033[33m' ok=$'\033[32m' dim=$'\033[2m' reset=$'\033[0m'
  while IFS=$'\t' read -r _ wt branch; do
    untracked=$(git -C "$wt" ls-files --others --exclude-standard 2>/dev/null)
    if [[ -n $untracked ]]; then
      print -u2 -- "${warn}skip${reset} ${dim}$wt${reset}  untracked files"
      continue
    fi
    if [[ -d "$wt/.claude" ]]; then
      extra=$(command ls -A "$wt/.claude" 2>/dev/null | grep -v '^settings.local.json$')
      if [[ -n $extra ]]; then
        print -u2 -- "${warn}skip${reset} ${dim}$wt${reset}  .claude/ has files other than settings.local.json"
        continue
      fi
    fi
    if (( force )); then
      git worktree remove --force "$wt" || continue
    else
      git worktree remove "$wt" || continue
    fi
    print -u2 -- "${ok}removed${reset} ${dim}$wt${reset}"
    if (( with_branch )) && [[ $branch != "(detached)" ]]; then
      if (( force )); then
        git branch -D "$branch"
      else
        git branch -d "$branch"
      fi
    fi
  done <<< "$selected"
}

# gwtcd: Pick a git worktree via fzf and cd into it. Preview shows recent commits.
# Display: "<*|·> <branch>  <commit>  <relative-path>  <dirty>"; absolute path is hidden but used for cd.
# Dirty marker (lsd-style summary): ✔ = clean, ●N = N changed files (incl. untracked).
# Colors match git defaults: commit=yellow, branch=green, detached=grey, path=dim.
gwtcd() {
  local repo_root target
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || return
  target=$(git worktree list --porcelain 2>/dev/null \
    | awk -v root="$repo_root" -v pwd="$PWD" '
        BEGIN {
          R="\033[0m"; DIM="\033[2m"; BOLD="\033[1m"
          GREEN="\033[32m"; YELLOW="\033[33m"; GREY="\033[90m"
        }
        /^worktree /  { path=substr($0,10) }
        /^HEAD /      { commit=substr($2,1,8) }
        /^branch /    { branch=$2; sub("refs/heads/","",branch) }
        /^detached$/  { branch="(detached)" }
        /^$/ {
          if (path) {
            rel=path
            if (path==root) rel="."
            else { prefix=root"/"; if (index(path,prefix)==1) rel=substr(path,length(prefix)+1) }
            mark=(path==pwd ? BOLD YELLOW "*" R : DIM "\xc2\xb7" R)
            bcol=(branch=="(detached)" ? GREY : GREEN)
            pad=45-length(branch); if (pad<0) pad=0
            spaces=sprintf("%*s", pad, "")
            # dirty marker (lsd-style): count changed files (incl. untracked).
            #   clean -> green check (\xe2\x9c\x94, width 1); dirty -> yellow bullet + count (\xe2\x97\x8f).
            # Placed right after the mark so it stays visible even when fzf truncates the line.
            cmd="git -C \"" path "\" status --porcelain 2>/dev/null | wc -l"
            cmd | getline cnt; close(cmd); cnt=cnt+0
            if (cnt==0) { sym=GREEN "\xe2\x9c\x94" R; vis=1 }
            else        { sym=YELLOW "\xe2\x97\x8f" cnt R; vis=1+length(cnt) }
            spad=4-vis; if (spad<0) spad=0
            sp=sprintf("%*s", spad, "")
            printf "%s %s%s %s%s%s%s %s%s%s  %s%s%s\t%s\n",
              mark, sym, sp, bcol, branch, R, spaces, YELLOW, commit, R, DIM, rel, R, path
            path=""; commit=""; branch=""
          }
        }' \
    | fzf --ansi --header='Switch to git worktree (* = current)' \
          --delimiter='\t' --with-nth=1 \
          --preview='git -C {2} log --oneline --decorate --color=always -20 2>/dev/null' \
          --preview-window='right:60%:wrap' \
    | awk -F'\t' '{print $2}')
  [[ -n $target ]] && cd "$target"
}

# gwtmk: Create a git worktree for an EXISTING branch (local or remote) and cd into it.
# Folder name = branch with each "/" replaced by "--"  (e.g. feat/foo -> feat--foo),
#   or an explicit name given via -n/--name.
# Location: $GWT_DIR if set, else <repo-root>/.claude/worktrees.
# Only checks out branches that already exist:
#   - local branch          -> checked out directly
#   - only on a remote       -> a tracking local branch is created from it
#   - not found anywhere      -> error (does NOT create a brand-new branch)
# TAB after `gwtmk` completes existing local + remote branch names.
gwtmk() {
  local branch= name=
  while (( $# )); do
    case "$1" in
      -n|--name)
        [[ -n $2 ]] || { echo "gwtmk: $1 needs a value" >&2; return 1; }
        name="$2"; shift 2 ;;
      --name=*) name="${1#--name=}"; shift ;;
      -n=*)     name="${1#-n=}"; shift ;;
      -h|--help)
        print -r -- 'gwtmk - create a git worktree for an EXISTING branch and cd into it.

Usage:
  gwtmk <branch>                 # folder = branch with each "/" replaced by "--"
  gwtmk -n <name> <branch>       # folder = <name>
  gwtmk --name <name> <branch>   # same
  gwtmk --name=<name> <branch>   # "=" form also works
  gwtmk -n=<name> <branch>
  gwtmk <branch> -n <name>       # the flag may come before OR after the branch

Branch (only existing ones are accepted):
  local branch     -> checked out directly
  only on a remote -> a tracking local branch is created from it
  not found        -> error (gwtmk never creates a brand-new branch)

TAB after `gwtmk` completes existing local + remote branch names.

Location:
  $GWT_DIR if set, else <repo-root>/.claude/worktrees
  e.g. export GWT_DIR="$HOME/worktrees"'
        return 0 ;;
      -*) echo "gwtmk: unknown flag: $1" >&2; return 1 ;;
      *) branch="$1"; shift ;;
    esac
  done
  if [[ -z $branch ]]; then
    echo "Usage: gwtmk [-n|--name <folder>] <existing-branch>   (TAB completes branches)" >&2
    return 1
  fi

  local repo_root
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null) \
    || { echo "gwtmk: not in a git repo" >&2; return 1; }

  local base_dir="${GWT_DIR:-$repo_root/.claude/worktrees}"
  local dir="$base_dir/${name:-${branch//\//--}}"

  if [[ -e $dir ]]; then
    echo "gwtmk: path already exists: $dir" >&2
    return 1
  fi
  mkdir -p "$base_dir" || return 1

  local out
  if git show-ref --verify --quiet "refs/heads/$branch"; then
    # existing local branch
    out=$(git worktree add "$dir" "$branch" 2>&1) || { print -r -- "$out" >&2; return 1; }
  else
    # not local: look for it on any remote, strip the remote name to compare
    local r remote_ref=
    while IFS= read -r r; do
      if [[ ${r#*/} == $branch ]]; then remote_ref=$r; break; fi
    done < <(git for-each-ref --format='%(refname:short)' refs/remotes 2>/dev/null)

    if [[ -z $remote_ref ]]; then
      echo "gwtmk: branch not found locally or on any remote: $branch" >&2
      echo "        (gwtmk only checks out existing branches)" >&2
      return 1
    fi
    out=$(git worktree add --track -b "$branch" "$dir" "$remote_ref" 2>&1) \
      || { print -r -- "$out" >&2; return 1; }
  fi

  print -r -- "$out"
  cd "$dir"
}

# completion for gwtmk: -n/--name flag, plus existing local heads (full) +
# remote branches (remote name stripped). After -n the word is a free-text folder name.
_gwtmk() {
  if [[ $words[CURRENT-1] == (-n|--name) ]]; then
    return 0   # folder name is free text
  fi
  if [[ $words[CURRENT] == -* ]]; then
    compadd -- -n --name   # only offer flags when the user is typing one
    return
  fi
  local -a _gwt_branches
  _gwt_branches=(
    ${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null)"}
    ${(f)"$(git for-each-ref --format='%(refname:lstrip=3)' refs/remotes 2>/dev/null)"}
  )
  _gwt_branches=(${(u)_gwt_branches:#HEAD})
  compadd -a _gwt_branches
}
# gwtln: symlink per-worktree, gitignored paths (e.g. .venv .claude) from the MAIN
# worktree into the CURRENT worktree, so a fresh worktree can reuse them.
# Each arg is a path relative to the repo root. Existing entries are left untouched.
#   gwtln .venv .claude            # link both from main worktree into here
# Note: a symlinked .venv shares the main worktree's editable installs (pip -e .) and
#       its scripts' absolute paths — fine for read/import, but `pip install -e .` will
#       point at the MAIN source tree, not this worktree's. Use a real `poetry install`
#       per worktree if you need editable installs to track this worktree's code.
gwtln() {
  if [[ $# -eq 0 || $1 == -h || $1 == --help ]]; then
    print -r -- 'Usage: gwtln <path> [<path> ...]
  Symlink each <path> (relative to repo root) from the MAIN worktree into the
  current worktree. Intended for gitignored, per-worktree dirs like .venv .claude.
  Skips paths missing in main or already present here. TAB completes main-worktree
  ignored entries not yet present in the current worktree.'
    [[ $# -eq 0 ]] && return 1 || return 0
  fi

  local cur main
  cur=$(git rev-parse --show-toplevel 2>/dev/null) \
    || { echo "gwtln: not in a git repo" >&2; return 1; }
  main=$(git worktree list --porcelain 2>/dev/null \
    | awk '/^worktree /{print substr($0,10); exit}')
  [[ -n $main ]] || { echo "gwtln: cannot resolve main worktree" >&2; return 1; }
  if [[ $main == $cur ]]; then
    echo "gwtln: you are in the main worktree; nothing to link from" >&2
    return 1
  fi

  local p src dst rc=0
  local warn=$'\033[33m' ok=$'\033[32m' dim=$'\033[2m' reset=$'\033[0m'
  for p in "$@"; do
    p=${p#./}; p=${p%/}
    src="$main/$p"; dst="$cur/$p"
    if [[ ! -e $src && ! -L $src ]]; then
      print -u2 -- "${warn}skip${reset} ${dim}$p${reset}  not found in main worktree"
      rc=1; continue
    fi
    if [[ -L $dst ]]; then
      print -u2 -- "${warn}skip${reset} ${dim}$p${reset}  already a symlink here"
      continue
    fi
    if [[ -e $dst ]]; then
      print -u2 -- "${warn}skip${reset} ${dim}$p${reset}  already exists here (remove it first)"
      rc=1; continue
    fi
    mkdir -p "${dst:h}"
    if ln -s "$src" "$dst"; then
      print -- "${ok}linked${reset} $p ${dim}-> $src${reset}"
    else
      rc=1
    fi
  done
  return $rc
}

# completion for gwtln: ignored entries present in main worktree but not yet here.
_gwtln() {
  local cur main
  cur=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
  main=$(git worktree list --porcelain 2>/dev/null \
    | awk '/^worktree /{print substr($0,10); exit}')
  [[ -n $main && $main != $cur ]] || return 0
  local -a cands
  # --ignored=matching lists ignored entries (e.g. ".venv/") without recursing into them
  cands=(${(f)"$(git -C "$main" status --porcelain --ignored=matching 2>/dev/null \
    | awk '/^!! /{print substr($0,4)}')"})
  cands=(${cands%/})                       # drop trailing slash on dirs
  local -a todo
  local c
  for c in $cands; do [[ -e "$cur/$c" || -L "$cur/$c" ]] || todo+=("$c"); done
  compadd -a todo
}

# compinit is queued via zsh-defer before this file is sourced; defer compdef so it
# runs after compinit has defined `compdef`.
if (( $+functions[zsh-defer] )); then
  zsh-defer compdef _gwtmk gwtmk
  zsh-defer compdef _gwtln gwtln
else
  compdef _gwtmk gwtmk 2>/dev/null
  compdef _gwtln gwtln 2>/dev/null
fi
